{
  "series_variant_id": "f31acdf1-9e4a-4f2e-ab5e-00b03c09c08e",
  "series_product_type_id": "7e9e1006-b7e9-4a19-a9ee-d7966306db35",
  "name": "Lovika White Kakfat",
  "price": 249,
  "stock_quantity": 5,
  "size_label": "28 cm",
  "diameter_mm": 280
}

